{
  "name": "xinsheng-neu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "新生 · 一段属于普通同学的大学生活视觉小说",
  "scripts": {
    "dev": "node scripts/server.mjs",
    "start": "node scripts/server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "assets:portraits": "node scripts/optimize-portraits.mjs",
